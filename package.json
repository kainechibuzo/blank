{
  "name": "aitransparency",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Public database and comparison tool explaining, in plain English, what AI products do with your data.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check:policies": "node scripts/check-policy-hashes.mjs",
    "check:traceability": "node scripts/traceability-check.mjs",
    "check:render": "esbuild scripts/render-check.jsx --bundle --platform=node --format=esm --outfile=node_modules/.cache/render-check.mjs --loader:.jsx=jsx --jsx=automatic --packages=external --log-level=warning && node node_modules/.cache/render-check.mjs",
    "check:edge": "node scripts/check-edge-diagnosis.mjs",
    "check:observer": "node scripts/check-observer.mjs",
    "check": "npm run check:traceability && npm run check:render && npm run check:edge && npm run check:observer",
    "check:snippets": "node scripts/check-directory-snippets.mjs",
    "setup:hooks": "git config core.hooksPath .githooks && echo \"pre-commit hook installed from .githooks/\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.0",
    "vite": "^6.3.0"
  }
}
