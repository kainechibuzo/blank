# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# These are the ONLY two values the browser needs. The Supabase anon key is
# designed to be public (it is safe in a client bundle); row level security is
# what protects the data, not the secrecy of this key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only. Used by scripts/check-directory-snippets.mjs (the weekly
# snippet re-check) and by the GitHub Actions workflow of the same name.
# This one IS a credential — it bypasses row level security. Put it in
# .env locally and in GitHub Actions secrets for CI. Never in the browser,
# never in VITE_* variables, never committed.
SUPABASE_SERVICE_ROLE_KEY=

# Where "contact support" in a tamper warning points.
VITE_SUPPORT_EMAIL=support@example.org
